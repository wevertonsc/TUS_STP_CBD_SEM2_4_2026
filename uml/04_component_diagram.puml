@startuml Component_Diagram
!theme plain
skinparam backgroundColor #FAFBFC
skinparam componentBackgroundColor #EEF4FB
skinparam componentBorderColor #1F4E79
skinparam componentFontColor #1F4E79
skinparam componentFontSize 12
skinparam interfaceBackgroundColor #FFFFFF
skinparam interfaceBorderColor #1F4E79
skinparam packageBackgroundColor #F8F9FA
skinparam packageBorderColor #AAAAAA
skinparam packageFontColor #333333
skinparam ArrowColor #1F4E79
skinparam ArrowThickness 1.5
skinparam noteBorderColor #CC9900
skinparam noteBackgroundColor #FFF9E6
skinparam linetype ortho
skinparam padding 6
skinparam roundcorner 10

title Stock Options Predictor - Component Diagram

' ─── External Clients ─────────────────────────────────────────
package "External" #F0F0F0 {
    actor "API Consumer\n(curl / Postman)" as APIClient
    component "Swagger UI\n/swagger-ui.html" as Swagger <<web browser>>
}

' ─── Application Container ────────────────────────────────────
package "Docker Container: stock-predictor:latest\n(eclipse-temurin:17-jre-alpine | port 8080)" #DCEEFB {

    package "Spring Boot Application" #EEF4FB {

        package "Presentation Layer\n(Spring MVC)" #E3F2FD {
            component [PredictionController\n/api/v1/predict/**] as PC <<@RestController>>
            component [StockPriceController\n/api/v1/stocks/**] as SC <<@RestController>>
            component [GlobalExceptionHandler] as GEH <<@RestControllerAdvice>>
            component [SpringDoc OpenAPI\n/api-docs] as OAS <<auto-generated>>
        }

        package "Service Layer\n(Business Logic)" #E8F5E9 {
            component [PredictionService\nEMA-14 | SMA-20 | OLS] as PS <<@Service>>
            component [StockPriceService\nCRUD operations] as SS <<@Service>>
        }

        package "Persistence Layer\n(Spring Data JPA)" #FFF3E0 {
            component [StockPriceRepository] as Repo <<@Repository>>
            component [DataInitializer\nSeeds 180 records on startup] as DI <<@Component>>
        }

        package "Cross-cutting Concerns" #F3E5F5 {
            component [Spring Boot Actuator\n/actuator/health\n/actuator/info\n/actuator/metrics] as Actuator <<auto-configured>>
            component [JaCoCo Agent\n(test phase only)] as JaCoCo <<runtime agent>>
        }
    }

    database "H2 In-Memory DB\njdbc:h2:mem:stockdb\nTable: stock_prices" as H2DB #FFF9E6
}

' ─── CI/CD Infrastructure ─────────────────────────────────────
package "CI/CD Infrastructure" #F5F5F5 {

    package "Source Control" #E8F5E9 {
        component [GitHub Repository\nmain branch] as GH <<VCS>>
        component [GitHub Actions\n.github/workflows/ci-cd.yml] as GHA <<workflow>>
    }

    package "Build & Quality" #FFF3E0 {
        component [Jenkins Server\nJenkinsfile] as Jenkins <<CI server>>
        component [Maven 3.9\nBuild Lifecycle] as Maven <<build tool>>
        component [SonarQube Server\nlocalhost:9000] as SQ <<quality gate>>
    }

    package "Container Registry" #E3F2FD {
        component [Docker Engine] as DockerEng <<container runtime>>
        component [Docker Hub\n(optional push)] as DockHub <<registry>>
    }

    package "Deployment Automation" #F3E5F5 {
        component [Ansible\nansible/deploy.yml] as Ansible <<IaC>>
    }
}

' ─── Interfaces ───────────────────────────────────────────────
interface "REST API\nHTTP/JSON" as RestAPI
interface "JPA\nHibernate ORM" as JPA_IF
interface "JDBC\nH2 Driver" as JDBC_IF
interface "Webhook\nPOST /github-webhook/" as Webhook
interface "SonarQube API\nHTTP" as SQApi
interface "Quality Gate\nPass/Fail" as QGate

' ─── Client Connections ───────────────────────────────────────
APIClient   --> RestAPI
Swagger     --> RestAPI
RestAPI     -- PC
RestAPI     -- SC
OAS         ..> RestAPI : describes

' ─── Internal wiring ──────────────────────────────────────────
PC --> PS : delegates prediction
SC --> SS : delegates CRUD
PS --> Repo : reads stock history
SS --> Repo : reads / writes
DI --> Repo : seeds on startup
Repo --> JPA_IF
JPA_IF --> JDBC_IF
JDBC_IF --> H2DB
GEH ..> PC : intercepts exceptions
GEH ..> SC : intercepts exceptions

' ─── Actuator ─────────────────────────────────────────────────
APIClient ..> Actuator : GET /actuator/health

' ─── CI/CD wiring ─────────────────────────────────────────────
GH --> Webhook
Webhook --> Jenkins : trigger
Jenkins --> Maven : invokes lifecycle
Jenkins --> GHA : alternative runner
Maven ..> SQApi : sonar:sonar goal
SQApi --> SQ
SQ --> QGate
QGate --> Jenkins : PASS / FAIL
Jenkins --> DockerEng : docker build / run
DockerEng --> DockHub : docker push (main branch)
Ansible ..> DockerEng : idempotent deploy

note right of PS
  Time Series Algorithms:
  EMA(i) = (close(i) - EMA(i-1)) * k + EMA(i-1)
  where k = 2 / (period + 1)

  SMA(i) = sum(close[i-n..i]) / n

  OLS: y = slope * x + intercept
  via least-squares minimisation

  Confidence: predicted +/- 1.96 * stdDev
end note

note bottom of H2DB
  Resets on each restart.
  Production would use
  PostgreSQL + Flyway migrations.
end note

@enduml
